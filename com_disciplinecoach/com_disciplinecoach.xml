<extension type="component" method="upgrade">

    <name>COM_DISCIPLINECOACH</name>

    <author>Frits van Leeuwen</author>
    <creationDate>2026-10-28</creationDate>
    <copyright>Copyright (C) 2026 Frits van Leeuwen</copyright>
    <license>GNU General Public License version 2 or later</license>

    <version>0.1.3</version>

    <description>COM_DISCIPLINECOACH_DESCRIPTION</description>

    <scriptfile>script.php</scriptfile>

    <namespace path="src">Fvl\Component\DisciplineCoach\Administrator</namespace>

    <administration>

        <menu link="index.php?option=com_disciplinecoach">
            COM_DISCIPLINECOACH
        </menu>

        <files folder="administrator">
            <folder>forms</folder>
            <folder>services</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>sql</folder>
            <folder>language</folder>
        </files>

    </administration>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install/mysql/install.sql</file>
        </sql>
    </install>

    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall/mysql/uninstall.sql</file>
        </sql>
    </uninstall>

    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <media destination="com_disciplinecoach" folder="media/com_disciplinecoach">
        <folder>css</folder>
        <folder>images</folder>
        <folder>js</folder>
    </media>

</extension>
