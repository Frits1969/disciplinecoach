<form>

    <fieldset name="basic">

        <field name="title" type="text" label="Title" required="true" />

        <field name="alias" type="text" label="Alias" required="true" />

        <field name="image" type="media" label="Image" directory="disciplines" preview="true" />

        <field name="published" type="radio" label="Published" default="1">
            <option value="1">Yes</option>
            <option value="0">No</option>
        </field>

    </fieldset>

</form>
